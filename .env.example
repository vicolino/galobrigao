# Provedor de pagamento: "sandbox" (teste, sem cobrança) ou deixe vazio para usar o Mercado Pago quando houver token.
PAYMENT_PROVIDER=sandbox
# Credencial do Mercado Pago (use a de TESTE primeiro: TEST-...). Painel: mercadopago.com.br/developers
MP_ACCESS_TOKEN=
# Chave secreta das notificações (webhooks) do Mercado Pago, para validar a assinatura.
MP_WEBHOOK_SECRET=
# URL pública do jogo (o Mercado Pago precisa alcançar /api/webhooks/mercadopago).
PUBLIC_URL=http://localhost:5173
# Banco de dados
DB_FILE=data/rinha.sqlite
# E-mail (recuperar senha). Sem chave, o link aparece no console do servidor.
RESEND_API_KEY=
MAIL_FROM=Galo Brigão <nao-responda@seudominio.com.br>

# Produção: atrás do Caddy (proxy) use TRUST_PROXY=1. Em produção o pagamento de teste fica DESLIGADO,
# a menos que ALLOW_SANDBOX=1 (nunca use isso com o site aberto ao público).
NODE_ENV=
TRUST_PROXY=
HOST=127.0.0.1
PORT=8787

# ---- Web3 (opcional; sem estas variáveis a carteira cripto fica desligada) ----
# Rede: testnet = Polygon Amoy (80002) · mainnet = Polygon PoS (137) · local = Hardhat/Anvil (31337)
WEB3_NETWORK=
# RPC (opcional na testnet/mainnet: usa o público da Polygon). Endereços vêm de scripts/deploy-contracts.mjs
WEB3_RPC_URL=
WEB3_OPERATOR_KEY=
WEB3_WALLET_SECRET=
WEB3_EGG=
WEB3_CORN=
WEB3_ITEMS=
WEB3_MARKET=
# Na mainnet, vazio = USDC nativo da Circle na Polygon
WEB3_USDC=
# Limites diários: "egg:5000,corn:200000,usdc:500"
WEB3_DAILY_SEND_CAP=
WEB3_DAILY_BRIDGE_CAP=
# MAINNET: a camada web3 só liga com WEB3_MAINNET_ACK=yes + KYC_PROVIDER real (não "manual")
# + economia no servidor ligada no backoffice. Leia docs/MAINNET-CHECKLIST.md antes.
WEB3_MAINNET_ACK=
KYC_PROVIDER=
